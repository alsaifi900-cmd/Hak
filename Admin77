-- Helper function to get selected player (Touch-friendly dropdown)
function getPlayerFromSelection()
    local players = Players:GetPlayers()
    local selectedPlayer = nil

    -- Simple selection (replace with a dropdown in a real GUI)
    for _, player in pairs(players) do
        if player ~= LocalPlayer then
            selectedPlayer = player
            break
        end
    end

    return selectedPlayer
end

