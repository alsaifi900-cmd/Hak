-- Toggle GUI with a screen tap (double-tap)
local tapCount = 0
local lastTap = 0
UserInputService.TouchTap:Connect(function()
    local currentTime = tick()
    if currentTime - lastTap < 0.5 then
        tapCount = tapCount + 1
        if tapCount >= 2 then
            MainFrame.Visible = not MainFrame.Visible
            tapCount = 0
        end
    else
        tapCount = 1
    end
    lastTap = currentTime
end)

