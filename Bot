        await message.answer("❌ الملف لازم يكون .txt")
        return
    
    # تحميل الملف
    file = await bot.get_file(message.document.file_id)
    file_path = f"passwords_{message.from_user.id}.txt"
    
    await bot.download_file(file.file_path, file_path)
    
    # حفظ اليوزر
    username = message.caption or "user"
    with open(f"user_{message.from_user.id}.txt", "w") as f:
        f.write(username)
    
    # عد الأسطر
